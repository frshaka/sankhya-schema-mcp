SANKHYA_DB_HOST=localhost
SANKHYA_DB_PORT=1521
# Conexão por SID (padrão). Use SANKHYA_DB_SERVICE_NAME para conectar por service name.
SANKHYA_DB_SERVICE=XE
# tem precedência sobre o SID quando informado
# SANKHYA_DB_SERVICE_NAME=ORCLPDB1
SANKHYA_DB_USER=SANKHYA
SANKHYA_DB_PASSWORD=developer
# Schema onde as tabelas do Sankhya moram, quando não é o do usuário conectado.
# Necessário sempre que o login do MCP (tipicamente um usuário somente-leitura)
# não é o dono das tabelas: sem isso, table_sample e search_entities respondem
# ORA-00942 e a tradução de EntityName para nome de tabela para de funcionar.
# Ausente = a sessão não é alterada.
# SANKHYA_DB_SCHEMA=SANKHYA
